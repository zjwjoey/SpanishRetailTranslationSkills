{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retail item input 1.0.0-foundation + ikea-es-v1-candidate",
  "type": "object",
  "required": [
    "item_id",
    "platform",
    "product_id",
    "source_snapshot",
    "source",
    "source_locations"
  ],
  "properties": {
    "item_id": {
      "type": "string",
      "minLength": 1
    },
    "product_id": {
      "type": "string",
      "minLength": 1
    },
    "source_snapshot": {
      "type": "object",
      "required": [
        "label",
        "sha256",
        "captured_at"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "captured_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "platform": {
      "enum": [
        "action",
        "amazon",
        "ikea"
      ]
    },
    "is_synthetic": {
      "type": "boolean"
    },
    "source": {
      "type": "object",
      "minProperties": 1
    },
    "source_locations": {
      "type": "object",
      "minProperties": 1
    },
    "verification_status": {
      "enum": [
        "RAW",
        "CANDIDATE",
        "VERIFIED",
        "REJECTED",
        "SOURCE_ISSUE",
        "ALIGNMENT_UNCERTAIN",
        "REVIEW_REQUIRED"
      ]
    },
    "verification": {
      "type": [
        "object",
        "null"
      ]
    },
    "dataset_split": {
      "enum": [
        "unassigned",
        "train",
        "validation",
        "holdout"
      ]
    },
    "group_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "verification_status"
        ],
        "properties": {
          "verification_status": {
            "const": "VERIFIED"
          }
        }
      },
      "then": {
        "required": [
          "verification"
        ],
        "properties": {
          "verification": {
            "type": "object",
            "required": [
              "human_id",
              "confirmed_at",
              "evidence_refs",
              "verified_fields"
            ],
            "properties": {
              "human_id": {
                "type": "string",
                "minLength": 1
              },
              "confirmed_at": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "verified_fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "dataset_split"
        ],
        "properties": {
          "dataset_split": {
            "enum": [
              "train",
              "validation",
              "holdout"
            ]
          }
        }
      },
      "then": {
        "required": [
          "group_id",
          "verification_status",
          "evaluation_reference_fields"
        ],
        "properties": {
          "group_id": {
            "type": "string",
            "minLength": 1
          },
          "verification_status": {
            "const": "VERIFIED"
          },
          "evaluation_reference_fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "platform": {
            "const": "ikea"
          }
        },
        "required": [
          "platform"
        ]
      },
      "then": {
        "properties": {
          "product_id": {
            "type": "string",
            "pattern": "^[0-9]{8}$"
          }
        }
      }
    }
  ]
}
