{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source audit 1.0.0-foundation",
  "type": "object",
  "required": [
    "item_id",
    "product_id",
    "source_snapshot",
    "mode",
    "contract_version",
    "knowledge_version",
    "decisions",
    "preservation_ledger",
    "conflicts",
    "truncations",
    "status"
  ],
  "properties": {
    "item_id": {
      "type": "string",
      "minLength": 1
    },
    "product_id": {
      "type": "string",
      "minLength": 1
    },
    "source_snapshot": {
      "type": "object",
      "required": [
        "label",
        "sha256",
        "captured_at"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "captured_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "mode": {
      "const": "SOURCE_AUDIT"
    },
    "contract_version": {
      "const": "1.0.0-foundation"
    },
    "knowledge_version": {
      "type": "string",
      "minLength": 1
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "decision_id",
          "item_id",
          "source_field",
          "source_span",
          "action",
          "reason",
          "target_field",
          "review_status"
        ],
        "properties": {
          "decision_id": {
            "type": "string",
            "minLength": 1
          },
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "source_field": {
            "type": "string",
            "minLength": 1
          },
          "source_span": {
            "type": "object",
            "required": [
              "quote",
              "occurrence",
              "start",
              "end"
            ],
            "properties": {
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "occurrence": {
                "type": "integer",
                "minimum": 1
              },
              "start": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "end": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          },
          "action": {
            "enum": [
              "TRANSLATE",
              "PRESERVE",
              "METADATA",
              "DEDUPLICATE",
              "EXCLUDE_FROM_DESCRIPTION",
              "REVIEW_REQUIRED"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "target_field": {
            "type": "string",
            "minLength": 1
          },
          "review_status": {
            "enum": [
              "PROPOSED",
              "REVIEW_REQUIRED"
            ]
          },
          "canonical_decision_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "const": "DEDUPLICATE"
                }
              }
            },
            "then": {
              "required": [
                "canonical_decision_id"
              ]
            }
          }
        ]
      }
    },
    "preservation_ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "decision_id",
          "source_field",
          "source_span",
          "disposition",
          "target_field",
          "retained_fact_refs"
        ],
        "properties": {
          "decision_id": {
            "type": "string",
            "minLength": 1
          },
          "source_field": {
            "type": "string",
            "minLength": 1
          },
          "source_span": {
            "type": "object",
            "required": [
              "quote",
              "occurrence",
              "start",
              "end"
            ],
            "properties": {
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "occurrence": {
                "type": "integer",
                "minimum": 1
              },
              "start": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "end": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          },
          "disposition": {
            "type": "string",
            "minLength": 1
          },
          "target_field": {
            "type": "string",
            "minLength": 1
          },
          "retained_fact_refs": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "required": [
                    "source_field",
                    "source_span",
                    "value"
                  ],
                  "properties": {
                    "source_field": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_span": {
                      "type": "object",
                      "required": [
                        "quote",
                        "occurrence",
                        "start",
                        "end"
                      ],
                      "properties": {
                        "quote": {
                          "type": "string",
                          "minLength": 1
                        },
                        "occurrence": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "start": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "minimum": 0
                        },
                        "end": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "minimum": 0
                        }
                      }
                    },
                    "value": {}
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "canonical_decision_id"
                  ],
                  "properties": {
                    "canonical_decision_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "minItems": 1
          }
        }
      }
    },
    "conflicts": {
      "type": "array"
    },
    "truncations": {
      "type": "array"
    },
    "status": {
      "enum": [
        "PASSED",
        "REVIEW_REQUIRED",
        "FAILED"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "conflicts": {
                "minItems": 1
              }
            }
          },
          {
            "properties": {
              "truncations": {
                "minItems": 1
              }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "REVIEW_REQUIRED",
              "FAILED"
            ]
          }
        }
      }
    }
  ]
}
